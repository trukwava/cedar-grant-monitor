PORT=4173
HOST=127.0.0.1
DB_PATH=./data/cedar.sqlite
DEMO_AS_OF=2026-10-29

# Optional local access gate. Leave unset for the open synthetic demo.
# Use strong unique values (12–256 characters). NEVER commit a real .env.
# CEDAR_ADMIN_PASSWORD=replace-with-a-long-unique-secret
# CEDAR_REVIEWER_PASSWORD=replace-with-another-long-secret
# CEDAR_VIEWER_PASSWORD=replace-with-a-third-long-secret
# No production CRM credentials or third-party identity provider required.

# Alternate protected mode for individually identified local users. Cannot be
# combined with the CEDAR_*_PASSWORD shared-role configuration above.
# Each orgId must exist in the local SQLite organizations table.
# Do not paste real secrets into a tracked file.
# CEDAR_USERS_JSON='[{"username":"demo-lead","orgId":"cedar-demo","role":"admin","password":"replace-with-strong-secret"}]'

# Identity mode accepts demo/local only; external OIDC is intentionally unavailable.
# CEDAR_IDENTITY_MODE=local
# NODE_ENV=production deliberately refuses to start this prototype.
